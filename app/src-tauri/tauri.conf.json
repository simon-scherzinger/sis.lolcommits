{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lolcommits",
  "version": "0.6.1",
  "identifier": "de.scherzinger.lolcommits",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "sh -c 'cd \"$(git rev-parse --show-toplevel)\" && mkdir -p app/src-tauri/resources && cp lolcommits PRIVACY.md app/src-tauri/resources/'",
    "beforeDevCommand": "sh -c 'cd \"$(git rev-parse --show-toplevel)\" && mkdir -p app/src-tauri/resources && cp lolcommits PRIVACY.md app/src-tauri/resources/'"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "lolcommits",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A selfie for every git commit",
    "copyright": "lolcommits contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/lolcommits": "lolcommits",
      "resources/PRIVACY.md": "PRIVACY.md"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "git"
        ]
      }
    },
    "createUpdaterArtifacts": false
  },
  "mainBinaryName": "lolcommits-app",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFMjEzOTQ0QjU2MUJCQTYKUldTbXUyRzFSRGtoVGtqV0UrZDRtY3pvMENoc1JYRndiTWR1Y3I0RVZwNWxMTXh2MC9xeU4zUGoK",
      "endpoints": [
        "https://github.com/simon-scherzinger/sis.lolcommits/releases/latest/download/latest.json"
      ]
    }
  }
}
