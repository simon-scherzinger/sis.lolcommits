#!/usr/bin/env bash
# lolcommits (2027 edition) – takes a webcam selfie on every git commit
# and puts the commit message on it. Needs: bash, git >= 2.54, ffmpeg.
# Runs on macOS (avfoundation) and Linux (v4l2).
set -u

VERSION="0.5.3"
LOLDIR="${LOLCOMMITS_DIR:-$(git config --get lolcommits.dir 2>/dev/null || echo "$HOME/.lolcommits")}"
LOLDIR="${LOLDIR/#\~/$HOME}"
INDEX="$LOLDIR/index.tsv"
LOG="$LOLDIR/lolcommits.log"
OS="$(uname -s)"

die()  { printf 'lolcommits: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }
cfg()  { git config --get "lolcommits.$1" 2>/dev/null || printf '%s' "${2:-}"; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 not found – install it first (macOS: brew install $1, Linux: apt/dnf install $1)"; }
open_file() {
  [ -n "${LOLCOMMITS_NO_OPEN:-}" ] && return 0
  if [ "$OS" = Darwin ]; then open "$1"; else xdg-open "$1" >/dev/null 2>&1 & fi
}
iso_now() { date +%Y-%m-%dT%H:%M:%S%z | sed -E 's/([0-9]{2})([0-9]{2})$/\1:\2/'; }

usage() {
  cat <<EOF
lolcommits $VERSION – a selfie for every commit

Usage: lolcommits <command> [options]

  enable [--global]     run on every commit (this repo, or all repos with --global)
  disable [--global]    stop running
  status                show hook + config state
  test                  take a test shot right now and open it
  last                  open the latest lolcommit
  gallery [--shared]    build an HTML gallery and open it (--shared: the team folder)
  timelapse [repo]      render an mp4 of all shots (or one repo)
  wrapped [year]        contact sheet of a year's commits (default: this year)
  devices               list cameras
  doctor                check dependencies
  ui                    open lolcommits.app

  share [file|last] [-y]      preview, then upload a picture to the team folder
  unshare [file|last|--all]   remove shared pictures (--all: your whole folder)
  sync                        download the team folder (used by gallery --shared)
  forget <file|last|--all>    delete pictures locally and their shared copies

Config (git config [--global] lolcommits.<key> <value>):
  device    camera: macOS index/name (default 0), Linux path (default /dev/video0)
  delay     seconds to let the camera warm up (default 1.5)
  size      capture size (default 1280x720)
  font      path to a .ttf (default: Impact, else DejaVu Sans Bold)
  dir       where pictures go (default ~/.lolcommits)
  enabled   set to false to pause in one repo without touching hooks
  pausedUntil  unix time until which no photos are taken (set by the app)
  retention delete local pictures after N days (default: keep)

  share.target     where to share: rclone:<remote>:<path> (Google Drive, S3, ...),
                   <host>:<path> (ssh) or a directory. Unset = never share.
  share.name       your name in the team gallery (a nickname is fine)
  (repo names: asked once per repo on the first share, stored in ~/.lolcommits/repo-names.tsv)
  share.retention  delete your shared pictures after N days (default 0 = keep)
  share.auto       true uploads every shot without preview (default false)

Skip a single commit with LOLCOMMITS_SKIP=1 git commit ...
EOF
}

# ---------------------------------------------------------------- hook setup
# Uses git's config-based hooks (git 2.54+), so existing .git/hooks scripts
# and core.hooksPath setups stay untouched.
cmd_enable() {
  local scope="--local"
  [ "${1:-}" = "--global" ] && scope="--global"
  [ "$scope" = "--local" ] && { git rev-parse --git-dir >/dev/null 2>&1 || die "not inside a git repo (use --global?)"; }
  local self; self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  if has_config_hooks; then
    git config "$scope" --unset-all hook.lolcommits.event 2>/dev/null
    git config "$scope" hook.lolcommits.event post-commit
    git config "$scope" hook.lolcommits.command "\"$self\" capture"
  else
    # git < 2.54: append to the classic hook script, keeping whatever is in it
    [ "$scope" = "--global" ] && die "--global needs git 2.54+ (you have $(git_version)); run 'lolcommits enable' per repo instead"
    local hook; hook="$(legacy_hook_path)"
    mkdir -p "$(dirname "$hook")"
    [ -f "$hook" ] || printf '#!/bin/sh\n' >"$hook"
    grep -q "$HOOK_MARK" "$hook" || printf '"%s" capture %s\n' "$self" "$HOOK_MARK" >>"$hook"
    chmod +x "$hook"
  fi
  info "lolcommits enabled (${scope#--}). Smile on your next commit."
}

cmd_disable() {
  local scope="--local" done=0
  [ "${1:-}" = "--global" ] && scope="--global"
  git config "$scope" --remove-section hook.lolcommits 2>/dev/null && done=1
  if [ "$scope" = "--local" ]; then
    local hook; hook="$(legacy_hook_path 2>/dev/null)"
    if [ -n "$hook" ] && [ -f "$hook" ] && grep -q "$HOOK_MARK" "$hook"; then
      grep -v "$HOOK_MARK" "$hook" >"$hook.tmp" && cat "$hook.tmp" >"$hook" && rm -f "$hook.tmp"; done=1
    fi
  fi
  [ $done = 1 ] && info "lolcommits disabled (${scope#--})." || info "lolcommits was not enabled (${scope#--})."
}

HOOK_MARK="# added by lolcommits"
git_version() { git --version | awk '{print $3}'; }
has_config_hooks() {
  local v major minor rest; v="$(git_version)"
  major="${v%%.*}"; rest="${v#*.}"; minor="${rest%%.*}"
  [ "$major" -gt 2 ] || { [ "$major" -eq 2 ] && [ "$minor" -ge 54 ]; }
}
legacy_hook_path() {
  local p; p="$(git rev-parse --git-path hooks/post-commit)" || return 1
  case "$p" in /*) printf '%s' "$p" ;; *) printf '%s/%s' "$(pwd)" "$p" ;; esac
}
check_git_version() {
  has_config_hooks || printf 'note: git %s has no config-based hooks (2.54+); per-repo hook scripts are used instead.\n' "$(git_version)" >&2
}

cmd_status() {
  info "dir:     $LOLDIR"
  info "global:  $(git config --global --get hook.lolcommits.command 2>/dev/null || echo off)"
  if git rev-parse --git-dir >/dev/null 2>&1; then
    local h; h="$(legacy_hook_path)"
    if git config --local --get hook.lolcommits.command >/dev/null 2>&1; then info "repo:    on (git config hook)"
    elif [ -f "$h" ] && grep -q "$HOOK_MARK" "$h"; then info "repo:    on ($h)"
    else info "repo:    off"; fi
    info "paused:  $( [ "$(cfg enabled true)" = false ] && echo yes || echo no )"
  fi
  [ -f "$INDEX" ] && info "shots:   $(wc -l <"$INDEX" | tr -d ' ')"
  if [ "$(share_mode)" = off ]; then info "share:   off"
  else
    info "share:   $(cfg share.target) as \"$(cfg share.name)\" (auto: $(cfg share.auto false), repos shown by name: $( [ -f "$REPO_NAMES" ] && grep -c '	show$' "$REPO_NAMES" || echo 0), keep: $( [ "$(cfg share.retention 0)" -gt 0 ] 2>/dev/null && echo "$(cfg share.retention 0) days" || echo forever))"
    [ -f "$SHARED" ] && info "shared:  $(wc -l <"$SHARED" | tr -d ' ') from this machine"
  fi
}

# ---------------------------------------------------------------- capture
font_file() {
  local f; f="$(cfg font)"
  [ -n "$f" ] && [ -f "$f" ] && { printf '%s' "$f"; return; }
  for f in \
    /System/Library/Fonts/Supplemental/Impact.ttf \
    /Library/Fonts/Impact.ttf \
    /usr/share/fonts/truetype/msttcorefonts/Impact.ttf \
    /usr/share/fonts/TTF/impact.ttf \
    /usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf \
    /usr/share/fonts/dejavu-sans-fonts/DejaVuSans-Bold.ttf \
    /usr/share/fonts/TTF/DejaVuSans-Bold.ttf \
    /System/Library/Fonts/Supplemental/Arial\ Bold.ttf; do
    [ -f "$f" ] && { printf '%s' "$f"; return; }
  done
  command -v fc-match >/dev/null 2>&1 && fc-match -f '%{file}' 'Impact:bold' 2>/dev/null
}

input_args() {
  local dev size
  # override for testing / exotic setups, e.g. "-f lavfi -i testsrc2=size=1280x720"
  if [ -n "${LOLCOMMITS_INPUT:-}" ]; then printf '%s\n' $LOLCOMMITS_INPUT; return; fi
  size="$(cfg size 1280x720)"
  if [ "$OS" = Darwin ]; then
    dev="$(cfg device 0)"
    printf '%s\n' -f avfoundation -pixel_format nv12 -framerate 30 -video_size "$size" -i "$dev:none"
  else
    dev="$(cfg device /dev/video0)"
    printf '%s\n' -f v4l2 -video_size "$size" -i "$dev"
  fi
}

# filter-safe quoting for drawtext option values
fq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# render <input-args...> -- <out.jpg> <sha> <subject> <repo> <branch>
render() {
  local args=() a
  while [ $# -gt 0 ]; do a="$1"; shift; [ "$a" = "--" ] && break; args+=("$a"); done
  local out="$1" sha="$2" subject="$3" repo="$4" branch="$5"
  local tmp; tmp="$(mktemp -d)"
  # at most 2 lines across the picture, "…" if the message is longer
  printf '%s' "$subject" | fold -s -w 56 | awk 'NR<=2{sub(/ +$/,""); l[NR]=$0} END{if(NR>2){sub(/[ ,.:;-]*$/,"",l[2]); l[2]=l[2] "…"} for(i=1;i<=NR&&i<=2;i++) print l[i]}' >"$tmp/msg.txt"
  printf '%s' "$sha" >"$tmp/sha.txt"
  printf '%s · %s' "$repo" "$branch" >"$tmp/repo.txt"
  local font; font="$(font_file)"
  local rc=0
  if has_drawtext; then
    # one pass: grab + caption with ffmpeg (typical on Linux distros)
    local ff=""; [ -n "$font" ] && ff="fontfile=$(fq "$font"):"
    local common="${ff}fontcolor=white:bordercolor=black:borderw=4"
    local align=""  # center multi-line captions (ffmpeg 7+)
    [ "$(ffmpeg -version | head -1 | awk '{print $3}' | sed 's/[^0-9].*//')" -ge 7 ] 2>/dev/null && align=":text_align=C"
    local vf="scale=1280:720:force_original_aspect_ratio=increase,crop=1280:720,"
    vf+="drawtext=${common}:textfile=$(fq "$tmp/msg.txt"):fontsize=64:line_spacing=6${align}:x=(w-text_w)/2:y=h-text_h-40,"
    vf+="drawtext=${common}:textfile=$(fq "$tmp/sha.txt"):fontsize=52:x=32:y=24,"
    vf+="drawtext=${common}:textfile=$(fq "$tmp/repo.txt"):fontsize=28:borderw=2:x=w-text_w-32:y=34"
    ffmpeg -hide_banner -loglevel error -y "${args[@]}" \
      -ss "$(cfg delay 1.5)" -frames:v 1 -vf "$vf" -map_metadata -1 -fflags +bitexact -flags:v +bitexact -q:v 3 "$out" || rc=$?
  else
    # two passes: grab with ffmpeg, caption with ImageMagick (e.g. Homebrew ffmpeg has no freetype)
    ffmpeg -hide_banner -loglevel error -y "${args[@]}" -ss "$(cfg delay 1.5)" -frames:v 1 \
      -vf "scale=1280:720:force_original_aspect_ratio=increase,crop=1280:720" -q:v 2 "$tmp/raw.jpg" || rc=$?
    if [ $rc = 0 ]; then
      local fa=(); [ -n "$font" ] && fa=(-font "$font")
      # text twice: thick black stroke underneath, clean white fill on top
      local cap=(-gravity south -pointsize 64 -interline-spacing 2 -annotate +0+40 "@$tmp/msg.txt"
                 -gravity northwest -pointsize 52 -annotate +32+24 "@$tmp/sha.txt"
                 -gravity northeast -pointsize 28 -annotate +32+34 "@$tmp/repo.txt")
      "$(imagick)" "$tmp/raw.jpg" ${fa[@]+"${fa[@]}"} \
        -fill black -stroke black -strokewidth 8 "${cap[@]}" \
        -fill white -stroke none "${cap[@]}" \
        -strip -quality 88 "$out" || rc=$?
    fi
  fi
  rm -rf "$tmp"
  return $rc
}

has_drawtext() {
  [ "${LOLCOMMITS_NO_DRAWTEXT:-}" = 1 ] && return 1
  ffmpeg -hide_banner -filters 2>/dev/null | grep -q ' drawtext '
}
imagick() { command -v magick >/dev/null 2>&1 && echo magick || echo convert; }
has_imagick() { command -v magick >/dev/null 2>&1 || command -v convert >/dev/null 2>&1; }

# lolcommits.folders (multi-valued): photos only in repos below one of them.
# None set: every repo.
in_folders() {
  local f found=0 any=0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    any=1; f="${f/#\~/$HOME}"
    f="$(cd "$f" 2>/dev/null && pwd -P || printf '%s' "${f%/}")"   # git reports resolved paths
    case "$1/" in "$f"/*) found=1 ;; esac
  done < <(git config --get-all lolcommits.folders 2>/dev/null)
  [ "$any" = 0 ] || [ "$found" = 1 ]
}

# Repo name from git, not from the folder: the origin remote ("org/name.git"
# -> "name"), else the main worktree's folder. So every worktree and every
# clone with another folder name counts as the same repo.
repo_name() {
  local url name common
  url="$(git remote get-url origin 2>/dev/null)"
  name="${url%/}"; name="${name%.git}"; name="${name##*/}"; name="${name##*:}"
  if [ -z "$name" ]; then
    common="$(git rev-parse --git-common-dir 2>/dev/null)"
    case "$common" in
      */.git) name="$(basename "$(cd "$common/.." && pwd)")" ;;
      *) name="$(basename "$(git rev-parse --show-toplevel)")" ;;
    esac
  fi
  printf '%s' "$name"
}

cmd_capture() {
  # called by git as post-commit hook: return immediately, shoot in background
  [ -n "${LOLCOMMITS_SKIP:-}" ] && return 0
  [ "$(cfg enabled true)" = false ] && return 0
  [ "$(cfg pausedUntil 0)" -gt "$(date +%s)" ] 2>/dev/null && return 0
  local gitdir; gitdir="$(git rev-parse --git-dir 2>/dev/null)" || return 0
  # no selfie storm during rebase / cherry-pick sequences
  [ -d "$gitdir/rebase-merge" ] || [ -d "$gitdir/rebase-apply" ] || [ -f "$gitdir/sequencer/todo" ] && return 0
  in_folders "$(git rev-parse --show-toplevel)" || return 0
  local sha subject repo branch
  sha="$(git rev-parse --short=10 HEAD)"
  subject="$(git log -1 --format=%s)"
  repo="$(repo_name)"
  branch="$(git branch --show-current 2>/dev/null)"; branch="${branch:-detached}"

  # with lolcommits.app installed the app takes the photo: one camera permission,
  # menu bar animation, no ffmpeg needed. We only leave a job in the queue.
  local app; app="$(app_bundle)"
  if [ -n "$app" ]; then
    mkdir -p "$LOLDIR/queue"
    local job; job="$LOLDIR/queue/$(date +%Y%m%d-%H%M%S)-$sha.tsv"
    printf '%s\t%s\t%s\t%s\t%s\n' "$(iso_now)" "$repo" "$branch" "$sha" \
      "$(printf '%s' "$subject" | tr '\t\n' '  ')" >"$job.tmp" && mv "$job.tmp" "$job"
    app_running || launch_app "$app"
    return 0
  fi
  command -v ffmpeg >/dev/null 2>&1 || return 0

  mkdir -p "$LOLDIR/$repo"
  local out="$LOLDIR/$repo/$(date +%Y%m%d-%H%M%S)-$sha.jpg"
  local now; now="$(iso_now)"
  local inargs=(); while IFS= read -r a; do inargs+=("$a"); done < <(input_args)

  (
    if render "${inargs[@]}" -- "$out" "$sha" "$subject" "$repo" "$branch"; then
      subject="$(printf '%s' "$subject" | tr '\t' ' ')"
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$now" "$repo" "$branch" "$sha" "$subject" "$out" >>"$INDEX"
      prune_local
      # auto-share only when explicitly switched on (git config lolcommits.share.auto true)
      if [ "$(cfg share.auto false)" = true ] && [ "$(share_mode)" != off ] && [ -n "$(cfg share.name)" ]; then
        local img; img="$(mktemp -d)/share.jpg"
        { share_prepare "$out" "$img" "$repo" && share_upload "$img" "$out" "$repo" "$subject"; } \
          || printf '%s auto-share failed for %s %s\n' "$now" "$repo" "$sha" >>"$LOG"
        rm -rf "$(dirname "$img")"
      fi
    else
      printf '%s capture failed for %s %s\n' "$now" "$repo" "$sha" >>"$LOG"
    fi
  ) </dev/null >>"$LOG" 2>&1 &
  disown 2>/dev/null || true
}

cmd_test() {
  need ffmpeg
  mkdir -p "$LOLDIR"
  local out="$LOLDIR/test.jpg"
  local inargs=(); while IFS= read -r a; do inargs+=("$a"); done < <(input_args)
  info "📸 say cheese…"
  render "${inargs[@]}" -- "$out" "c0ffee1337" "lolcommits test shot – looking good" "lolcommits" "main" \
    || die "capture failed (camera permission? try: lolcommits devices)"
  info "$out"; open_file "$out"
}

cmd_devices() {
  need ffmpeg
  if [ "$OS" = Darwin ]; then
    ffmpeg -hide_banner -f avfoundation -list_devices true -i "" 2>&1 | grep -E 'AVFoundation|\[[0-9]+\]' | sed -n '/video/,/audio/p'
  elif command -v v4l2-ctl >/dev/null 2>&1; then
    v4l2-ctl --list-devices
  else
    ls /dev/video* 2>/dev/null || info "no /dev/video* devices"
  fi
}

cmd_doctor() {
  local ok=1
  info "os:     $OS"
  info "git:    $(git --version | awk '{print $3}')"; check_git_version
  if command -v ffmpeg >/dev/null 2>&1; then
    info "ffmpeg: $(ffmpeg -version | head -1 | awk '{print $3}')"
    if has_drawtext; then info "text:   ffmpeg drawtext"
    elif has_imagick; then info "text:   ImageMagick ($(imagick)) – ffmpeg has no drawtext"
    else info "text:   ✗ ffmpeg has no drawtext and ImageMagick is missing (brew/apt install imagemagick)"; ok=0; fi
  else info "ffmpeg: ✗ missing"; ok=0; fi
  info "font:   $(font_file || true)"
  info "dir:    $LOLDIR"
  case "$(share_mode)" in
    off) info "share:  off" ;;
    rclone)
      local remote; remote="$(share_base)"; remote="${remote%%:*}"; remote="${remote%%,*}:"   # name[,options]:path
      if ! command -v rclone >/dev/null 2>&1; then info "share:  ✗ rclone missing (brew/apt install rclone)"; ok=0
      elif ! rclone listremotes 2>/dev/null | grep -qxF "$remote"; then info "share:  ✗ rclone remote $remote not configured (run: rclone config)"; ok=0
      else info "share:  $(cfg share.target) (rclone $(rclone version 2>/dev/null | head -1 | awk '{print $2}'))"; fi ;;
    *)
      if command -v rsync >/dev/null 2>&1; then info "share:  $(cfg share.target) ($(share_mode))"
      else info "share:  ✗ rsync missing"; ok=0; fi ;;
  esac
  [ "$(share_mode)" != off ] && [ -z "$(cfg share.name)" ] && { info "share:  ✗ lolcommits.share.name not set"; ok=0; }
  [ $ok = 1 ] && info "all good ✓" || exit 1
}

# ---------------------------------------------------------------- viewing
require_index() { [ -s "$INDEX" ] || die "no lolcommits yet – commit something!"; }

cmd_last() {
  require_index
  local f; f="$(tail -1 "$INDEX" | cut -f6)"
  info "$f"; open_file "$f"
}

html_escape() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'; }

# gallery_html <title> <all-label>, rows on stdin (newest first):
# date \t group \t label \t badge \t subject \t file   ("-" = empty)
gallery_html() {
  local title="$1" all="$2"
  {
    sed -e "s/TITLE/$(printf '%s' "$title" | html_escape)/" -e "s/ALL/$all/" <<'EOF'
<!doctype html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>TITLE</title>
<style>
:root{--bg:#f6f5f2;--fg:#1d1d1f;--mut:#6e6e73;--card:#fff}
@media (prefers-color-scheme:dark){:root{--bg:#121214;--fg:#f2f2f2;--mut:#9a9aa0;--card:#1c1c1f}}
body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.4 system-ui,sans-serif}
header{padding:24px 16px 8px;max-width:1400px;margin:auto;display:flex;gap:12px;align-items:baseline;flex-wrap:wrap}
h1{margin:0;font:900 32px Impact,system-ui,sans-serif;letter-spacing:.5px}
select,input{font:inherit;padding:6px 10px;border-radius:8px;border:1px solid var(--mut);background:var(--card);color:var(--fg)}
main{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px;padding:16px;max-width:1400px;margin:auto}
figure{margin:0;background:var(--card);border-radius:12px;overflow:hidden;box-shadow:0 1px 3px #0002}
img{width:100%;display:block;aspect-ratio:16/9;object-fit:cover;cursor:zoom-in}
figcaption{padding:8px 12px;font-size:13px;color:var(--mut);display:flex;justify-content:space-between;gap:8px}
code{color:var(--fg)}
dialog{padding:0;border:0;background:transparent;max-width:95vw}dialog img{max-height:90vh;width:auto;cursor:zoom-out}
dialog::backdrop{background:#000c}
</style></head><body>
<header><h1>TITLE</h1><span id="n"></span>
<select id="repo"><option value="">ALL</option></select>
<input id="q" type="search" placeholder="search messages…"></header>
<main id="g">
EOF
    while IFS="$(printf '\t')" read -r ts group label badge subject file; do
      [ -f "$file" ] || continue
      local e_sub e_grp e_lab="" e_badge=""
      e_sub="$(printf '%s' "$subject" | html_escape)"
      e_grp="$(printf '%s' "$group" | html_escape)"
      [ "$label" = - ] || e_lab=" · $(printf '%s' "$label" | html_escape)"
      [ "$badge" = - ] || e_badge="<code>$(printf '%s' "$badge" | html_escape)</code> · "
      printf '<figure data-repo="%s" data-msg="%s"><img loading="lazy" src="file://%s" alt="%s">' \
        "$e_grp" "$e_sub" "$file" "$e_sub"
      printf '<figcaption><span><b>%s</b>%s</span><span>%s<time datetime="%s">%s</time></span></figcaption></figure>\n' \
        "$e_grp" "$e_lab" "$e_badge" "$ts" "${ts%T*}"
    done
    cat <<'EOF'
</main><dialog id="d"><img id="di" alt=""></dialog>
<script>
const figs=[...document.querySelectorAll('figure')],repo=document.getElementById('repo'),q=document.getElementById('q'),n=document.getElementById('n');
[...new Set(figs.map(f=>f.dataset.repo))].sort().forEach(r=>repo.add(new Option(r,r)));
function f(){let c=0;const s=q.value.toLowerCase();figs.forEach(x=>{const v=(!repo.value||x.dataset.repo===repo.value)&&x.dataset.msg.toLowerCase().includes(s);x.hidden=!v;c+=v});n.textContent=c+' commits'}
repo.onchange=q.oninput=f;f();
const d=document.getElementById('d'),di=document.getElementById('di');
document.getElementById('g').onclick=e=>{if(e.target.tagName==='IMG'){di.src=e.target.src;d.showModal()}};d.onclick=()=>d.close();
</script></body></html>
EOF
  }
}

cmd_gallery() {
  if [ "${1:-}" = --shared ]; then gallery_shared; return; fi
  require_index
  local out="$LOLDIR/gallery.html"
  sort -r "$INDEX" | gallery_html lolcommits "all repos" >"$out"
  info "$out"; open_file "$out"
}

# ---------------------------------------------------------------- sharing
# Opt-in upload into a team folder. lolcommits.share.target picks the backend:
#   rclone:<remote>:<path>   any rclone remote – Google Drive, S3, ...
#   <host>:<path>            a server over ssh
#   <path>                   a local or mounted directory (Google Drive for desktop)
# Layout, sorted by repo (the same as lolcommits.app):
#   <repo>/<YYYYmmdd>-<person>-<rand>.jpg  +  .tsv sidecar (date, name, repo or "-", subject)
# Repos not allowed by name go to other-repos/ with the label blurred.
# One sidecar per picture, so people sharing at the same time never edit one file.
SHARED="$LOLDIR/shared.tsv"         # local file \t remote path
REPO_NAMES="$LOLDIR/repo-names.tsv" # repo \t show|hide – asked once per repo
CACHE="$LOLDIR/.shared"
OTHER_REPOS="other-repos"
RCLONE_FLAGS=(--drive-use-trash=false)   # really delete on Google Drive, no 30-day trash

share_mode() {
  case "$(cfg share.target)" in
    "") echo off ;;
    rclone:*) echo rclone ;;
    /*|~*|.*) echo local ;;
    *:*) echo ssh ;;
    *) echo local ;;
  esac
}
share_base() { local t; t="$(cfg share.target)"; t="${t#rclone:}"; printf '%s' "${t/#\~/$HOME}"; }
slug() {
  printf '%s' "$1" | sed -e 's/ä/ae/g;s/Ä/ae/g;s/ö/oe/g;s/Ö/oe/g;s/ü/ue/g;s/Ü/ue/g;s/ß/ss/g' \
    | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'
}
share_me() {
  local n; n="$(slug "$(cfg share.name)")"
  [ -n "$n" ] || die 'set a display name first (a nickname is fine): git config --global lolcommits.share.name "Your Name"'
  printf '%s' "$n"
}
require_share() { [ "$(share_mode)" != off ] || die 'no share target – e.g. git config --global lolcommits.share.target rclone:gdrive:lolcommits'; }
days_ago() { date -v-"$1"d +%F 2>/dev/null || date -d "-$1 days" +%F; }
abspath() { case "$1" in /*) printf '%s' "$1" ;; *) printf '%s/%s' "$PWD" "$1" ;; esac; }

# repo_choice <repo> → show | hide | (empty: not asked yet)
repo_choice() { [ -f "$REPO_NAMES" ] && awk -F'\t' -v r="$1" '$1==r{v=$2} END{printf "%s", v}' "$REPO_NAMES"; }
set_repo_choice() {
  mkdir -p "$LOLDIR"
  { [ -f "$REPO_NAMES" ] && awk -F'\t' -v r="$1" '$1!=r' "$REPO_NAMES"; printf '%s\t%s\n' "$1" "$2"; } >"$REPO_NAMES.tmp" \
    && mv -f "$REPO_NAMES.tmp" "$REPO_NAMES"
}
# folder name for a repo: keeps case, dots and dashes; never hidden or empty
repo_folder() {
  local f; f="$(printf '%s' "$1" | LC_ALL=C sed -E 's/[^A-Za-z0-9._-]/-/g; s/^\.+//')"
  case "$f" in ""|"$OTHER_REPOS") f=repo ;; esac
  printf '%s' "$f"
}
# folder a picture of <repo> goes to
share_folder() { if [ "$(repo_choice "$1")" = show ]; then repo_folder "$1"; else printf '%s' "$OTHER_REPOS"; fi; }

# share_put <local file> <remote rel path>
share_put() {
  local b; b="$(share_base)"
  case "$(share_mode)" in
    rclone) rclone copyto "${RCLONE_FLAGS[@]}" "$1" "$b/$2" ;;
    ssh)    ssh "${b%%:*}" "mkdir -p $(fq "$(dirname "${b#*:}/$2")") && cat > $(fq "${b#*:}/$2")" <"$1" ;;
    local)  mkdir -p "$(dirname "$b/$2")" && cp "$1" "$b/$2" ;;
  esac
}
# share_rm <rel> – also drops the repo folder once it is empty
share_rm() {
  local b; b="$(share_base)"
  case "$(share_mode)" in
    # only shared-drive managers may delete for good; others fall back to the trash
    rclone) rclone deletefile "${RCLONE_FLAGS[@]}" "$b/$1" 2>/dev/null ||
              rclone deletefile --drive-use-trash=true "$b/$1" 2>/dev/null ||
              [ -z "$(rclone lsf "$b/$1" 2>/dev/null)" ] ;;
    ssh)    ssh "${b%%:*}" "rm -f $(fq "${b#*:}/$1"); rmdir $(fq "$(dirname "${b#*:}/$1")") 2>/dev/null; true" </dev/null ;;
    local)  rm -f "$b/$1" && { rmdir "$(dirname "$b/$1")" 2>/dev/null; true; } ;;
  esac
}
# all pictures in the target as <folder>/<file>.jpg
share_ls() {
  local b; b="$(share_base)"
  case "$(share_mode)" in
    rclone) rclone lsf -R --files-only --max-depth 2 --include '*.jpg' "$b" 2>/dev/null ;;
    ssh)    ssh "${b%%:*}" "cd $(fq "${b#*:}") 2>/dev/null && find . -mindepth 2 -maxdepth 2 -name '*.jpg'" </dev/null | sed 's|^\./||' ;;
    local)  ( cd "$b" 2>/dev/null && find . -mindepth 2 -maxdepth 2 -name '*.jpg' | sed 's|^\./||' ) ;;
  esac
}
# my pictures, as <folder>/<YYYYmmdd>-<me>-<rand>  (no extension)
share_mine() {
  local me; me="$(share_me)"
  share_ls | grep -E "(^|/)[0-9]{8}-$me-[0-9a-f]{8}\.jpg$" | sed 's/\.jpg$//' | sort
}
share_pull() {    # mirror the team folder into $1 (deletions propagate)
  local b; b="$(share_base)"; mkdir -p "$1"
  case "$(share_mode)" in
    rclone) rclone sync "$b" "$1" ;;
    *)      rsync -a --delete "$b/" "$1/" ;;
  esac
}

# share_prepare <in.jpg> <out.jpg> <repo> – fresh JPEG without metadata; the
# label band at the top is blurred unless the repo may be shown by name
share_prepare() {
  local vf="null"
  [ "$(repo_choice "$3")" = show ] || vf="split[a][b];[b]crop=iw:110:0:0,boxblur=20:2[t];[a][t]overlay=0:0"
  ffmpeg -hide_banner -loglevel error -y -i "$1" -vf "$vf" -map_metadata -1 -fflags +bitexact -flags:v +bitexact -q:v 3 "$2"
}

# share_upload <prepared.jpg> <local file> <repo> <subject>
share_upload() {
  local img="$1" f="$2" repo="$3" subject="$4" me name d stem side shown
  name="$(cfg share.name)"; me="$(share_me)" || return 1
  d="$(basename "$f")"; d="${d:0:8}"
  stem="$(share_folder "$repo")/$d-$me-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
  shown="-"; [ "$(repo_choice "$repo")" = show ] && shown="$(printf '%s' "$repo" | tr '\t' ' ')"
  side="$(mktemp)"
  printf '%s\t%s\t%s\t%s\n' "${d:0:4}-${d:4:2}-${d:6:2}" "$(printf '%s' "$name" | tr '\t' ' ')" "$shown" "$subject" >"$side"
  if share_put "$img" "$stem.jpg" && share_put "$side" "$stem.tsv"; then
    printf '%s\t%s\n' "$f" "$stem.jpg" >>"$SHARED"; rm -f "$side"; share_prune; return 0
  fi
  share_rm "$stem.jpg" 2>/dev/null; rm -f "$side"; return 1
}

# drop own shared pictures older than lolcommits.share.retention days (default 0 = keep)
share_prune() {
  local days cutoff stem; days="$(cfg share.retention 0)"
  [ "$days" -gt 0 ] 2>/dev/null || return 0
  cutoff="$(days_ago "$days" | tr -d -)"
  share_mine | while IFS= read -r stem; do
    local fn="${stem##*/}"
    [ "${fn:0:8}" \< "$cutoff" ] || continue
    share_rm "$stem.jpg"; share_rm "$stem.tsv"
    [ -f "$SHARED" ] && { awk -F'\t' -v r="$stem.jpg" '$2!=r' "$SHARED" >"$SHARED.tmp"; mv -f "$SHARED.tmp" "$SHARED"; }
  done
}

cmd_share() {
  local f="" yes="" a
  for a in "$@"; do case "$a" in -y|--yes) yes=1 ;; last) ;; *) f="$a" ;; esac; done
  require_share; need ffmpeg; share_me >/dev/null; require_index
  [ -n "$f" ] && f="$(abspath "$f")" || f="$(tail -1 "$INDEX" | cut -f6)"
  local row; row="$(awk -F'\t' -v f="$f" '$6==f' "$INDEX" | tail -1)"
  [ -n "$row" ] || die "not a lolcommit: $f"
  [ -f "$SHARED" ] && cut -f1 "$SHARED" | grep -qxF "$f" && die "already shared: $f"
  local repo; repo="$(cut -f2 <<<"$row")"
  if [ -z "$(repo_choice "$repo")" ] && [ -z "$yes" ]; then
    # asked once per repo: client projects should stay anonymous
    printf 'May your team see the repo name "%s"? (folder "%s" instead of "%s") [y/N] ' "$repo" "$(repo_folder "$repo")" "$OTHER_REPOS"
    local yn=""; read -r yn </dev/tty || true
    case "$yn" in y|Y|yes|j|J|ja) set_repo_choice "$repo" show ;; *) set_repo_choice "$repo" hide ;; esac
  fi
  local tmp; tmp="$(mktemp -d)"
  share_prepare "$f" "$tmp/share.jpg" "$repo" || { rm -rf "$tmp"; die "could not prepare $f"; }
  if [ -z "$yes" ]; then
    # show exactly what gets uploaded – check for people in the background
    info "$tmp/share.jpg"; open_file "$tmp/share.jpg"
    printf 'Share this picture to %s/%s as "%s"? [y/N] ' "$(cfg share.target)" "$(share_folder "$repo")" "$(cfg share.name)"
    local ans=""; read -r ans </dev/tty || true
    case "$ans" in y|Y|yes|j|J|ja) ;; *) rm -rf "$tmp"; info "not shared."; return 0 ;; esac
  fi
  share_upload "$tmp/share.jpg" "$f" "$repo" "$(cut -f5 <<<"$row")"
  local rc=$?; rm -rf "$tmp"
  [ $rc = 0 ] && info "shared ✓" || die "upload failed"
}

cmd_unshare() {
  require_share
  share_me >/dev/null
  if [ "${1:-}" = --all ]; then
    # every picture of mine, also those shared from other computers
    local stem n=0
    while IFS= read -r stem; do
      share_rm "$stem.jpg" || die "could not delete $stem.jpg"; share_rm "$stem.tsv"; n=$((n + 1))
    done < <(share_mine)
    rm -f "$SHARED"; info "removed $n shared pictures of yours from $(cfg share.target) ✓"; return
  fi
  [ -s "$SHARED" ] || die "nothing shared from this machine (use --all to remove all of yours anyway)"
  local f="${1:-last}" rel
  if [ "$f" = last ]; then f="$(tail -1 "$SHARED" | cut -f1)"; else f="$(abspath "$f")"; fi
  rel="$(awk -F'\t' -v f="$f" '$1==f{print $2}' "$SHARED" | tail -1)"
  [ -n "$rel" ] || die "not shared: $f"
  share_rm "$rel" || die "could not delete $rel"
  share_rm "${rel%.jpg}.tsv"
  awk -F'\t' -v f="$f" '$1!=f' "$SHARED" >"$SHARED.tmp" && mv -f "$SHARED.tmp" "$SHARED"
  info "unshared ✓ $f"
}

# delete pictures locally (and their shared copies)
cmd_forget() {
  case "${1:-}" in
    --all)
      if [ "${2:-}" != --yes ]; then
        printf 'Delete ALL lolcommits in %s%s? [y/N] ' "$LOLDIR" \
          "$( [ "$(share_mode)" != off ] && [ -n "$(cfg share.name)" ] && printf ' and your pictures in %s' "$(cfg share.target)")"
        local ans=""; read -r ans </dev/tty || true
        case "$ans" in y|Y|yes|j|J|ja) ;; *) info "nothing deleted."; return 0 ;; esac
      fi
      if [ "$(share_mode)" != off ] && [ -n "$(cfg share.name)" ]; then ( cmd_unshare --all ) || true; fi
      [ -f "$INDEX" ] && cut -f6 "$INDEX" | while IFS= read -r f; do rm -f "$f"; done
      rm -f "$INDEX" "$SHARED" "$REPO_NAMES" "$LOLDIR/private.tsv" "$LOG" "$LOLDIR"/gallery*.html "$LOLDIR"/timelapse*.mp4 "$LOLDIR"/wrapped-*.jpg "$LOLDIR/test.jpg"
      rm -rf "$CACHE" "$LOLDIR/.preview"
      find "$LOLDIR" -mindepth 1 -type d -empty -delete 2>/dev/null
      info "all lolcommits deleted ✓" ;;
    "") die "usage: lolcommits forget <file|last|--all [--yes]>" ;;
    *)
      require_index
      local f="$1"
      if [ "$f" = last ]; then f="$(tail -1 "$INDEX" | cut -f6)"; else f="$(abspath "$f")"; fi
      [ -f "$SHARED" ] && cut -f1 "$SHARED" | grep -qxF "$f" && cmd_unshare "$f"
      rm -f "$f"
      awk -F'\t' -v f="$f" '$6!=f' "$INDEX" >"$INDEX.tmp" && mv -f "$INDEX.tmp" "$INDEX"
      info "deleted ✓ $f" ;;
  esac
}

# where the team pictures can be read: the folder itself for local targets
# (Google Drive for desktop, NAS), a downloaded copy otherwise
team_dir() { if [ "$(share_mode)" = local ]; then share_base; else printf '%s' "$CACHE"; fi; }

cmd_sync() {
  require_share
  if [ "$(share_mode)" = local ]; then info "$(share_base) is a local folder – nothing to sync"; return 0; fi
  if [ "$(share_mode)" = rclone ]; then need rclone; else need rsync; fi
  info "syncing $(cfg share.target)…"
  share_pull "$CACHE" || die "could not sync $(cfg share.target)"
}

gallery_shared() {
  cmd_sync
  local cutoff="0000" days; days="$(cfg share.retention 0)"
  [ "$days" -gt 0 ] 2>/dev/null && cutoff="$(days_ago "$days")"
  local out="$LOLDIR/gallery-shared.html" side tdir; tdir="$(team_dir)"
  for side in "$tdir"/*/*.tsv; do
    [ -f "$side" ] && [ -f "${side%.tsv}.jpg" ] || continue
    awk -F'\t' -v f="${side%.tsv}.jpg" -v c="$cutoff" 'BEGIN{OFS="\t"} NR==1 && $1>=c {print $1,$2,($3==""?"-":$3),"-",$4,f}' "$side"
  done | sort -r | gallery_html "lolcommits · team" "everyone" >"$out"
  info "$out"; open_file "$out"
}

# local retention: lolcommits.retention days (unset = keep forever)
prune_local() {
  local days cutoff; days="$(cfg retention)"
  [ "$days" -gt 0 ] 2>/dev/null && [ -f "$INDEX" ] || return 0
  cutoff="$(days_ago "$days")"
  awk -F'\t' -v c="$cutoff" 'substr($1,1,10)<c{print $6}' "$INDEX" | while IFS= read -r f; do rm -f "$f"; done
  awk -F'\t' -v c="$cutoff" 'substr($1,1,10)>=c' "$INDEX" >"$INDEX.tmp" && mv -f "$INDEX.tmp" "$INDEX"
}

# concat list from index lines on stdin
concat_list() {
  local dur="$1"
  while IFS="$(printf '\t')" read -r _ _ _ _ _ file; do
    [ -f "$file" ] || continue
    printf "file '%s'\nduration %s\n" "$(printf '%s' "$file" | sed "s/'/'\\\\''/g")" "$dur"
  done
}

cmd_timelapse() {
  need ffmpeg; require_index
  local repo="${1:-}" list out
  list="$(mktemp)"
  if [ -n "$repo" ]; then
    sort "$INDEX" | awk -F'\t' -v r="$repo" '$2==r' | concat_list 0.2 >"$list"
    out="$LOLDIR/timelapse-$repo.mp4"
  else
    sort "$INDEX" | concat_list 0.2 >"$list"; out="$LOLDIR/timelapse.mp4"
  fi
  [ -s "$list" ] || die "no shots found${repo:+ for $repo}"
  ffmpeg -hide_banner -loglevel error -y -f concat -safe 0 -i "$list" \
    -vf "scale=1280:720:force_original_aspect_ratio=decrease,pad=1280:720:(ow-iw)/2:(oh-ih)/2,fps=25,format=yuv420p" \
    -c:v libx264 -movflags +faststart "$out" || die "rendering failed"
  rm -f "$list"; info "$out"; open_file "$out"
}

cmd_wrapped() {
  need ffmpeg; require_index
  local year="${1:-$(date +%Y)}" list out count cols rows
  list="$(mktemp)"
  sort "$INDEX" | awk -F'\t' -v y="$year" 'substr($1,1,4)==y' | concat_list 1 >"$list"
  count=$(( $(wc -l <"$list") / 2 ))
  [ "$count" -gt 0 ] || die "no lolcommits in $year"
  cols=1; while [ $((cols * cols)) -lt "$count" ]; do cols=$((cols + 1)); done
  [ "$cols" -gt 12 ] && cols=12
  rows=$(( (count + cols - 1) / cols ))
  out="$LOLDIR/wrapped-$year.jpg"
  ffmpeg -hide_banner -loglevel error -y -f concat -safe 0 -i "$list" \
    -vf "scale=320:180:force_original_aspect_ratio=increase,crop=320:180,tile=${cols}x${rows}:padding=4:margin=8:color=black" \
    -frames:v 1 -q:v 3 "$out" || die "rendering failed"
  rm -f "$list"
  info "$year wrapped: $count commits → $out"; open_file "$out"
}

# ---------------------------------------------------------------- app
# real location of this script (follows the ~/.local/bin symlink)
script_home() {
  local p="$0" l
  while [ -L "$p" ]; do l="$(readlink "$p")"; case "$l" in /*) p="$l" ;; *) p="$(dirname "$p")/$l" ;; esac; done
  cd "$(dirname "$p")" && pwd
}
# path of lolcommits.app (macOS) or the lolcommits-app binary (Linux), empty if none
app_bundle() {
  [ "${LOLCOMMITS_NO_APP:-}" = 1 ] && return 0
  [ -n "${LOLCOMMITS_APP:-}" ] && { printf '%s' "$LOLCOMMITS_APP"; return; }
  local home; home="$(script_home)"
  case "$home" in *.app/Contents/Resources) printf '%s' "${home%/Contents/Resources}"; return ;; esac
  local a
  for a in /Applications/lolcommits.app "$HOME/Applications/lolcommits.app"; do
    [ "$OS" = Darwin ] && [ -d "$a" ] && { printf '%s' "$a"; return; }
  done
  [ "$OS" = Linux ] && command -v lolcommits-app 2>/dev/null
  return 0
}
app_running() { pgrep -x lolcommits-app >/dev/null 2>&1; }
launch_app() {
  case "$1" in
    *.app) open -g -a "$1" --args --background ;;
    *) nohup "$1" --background </dev/null >/dev/null 2>&1 & ;;
  esac
}
cmd_ui() {
  local app; app="$(app_bundle)"
  [ -n "$app" ] || die "lolcommits.app is not installed – get it from https://github.com/simon-scherzinger/sis.lolcommits/releases"
  case "$app" in *.app) open -a "$app" ;; *) nohup "$app" </dev/null >/dev/null 2>&1 & ;; esac
}

# ---------------------------------------------------------------- main
cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  enable|disable|status|capture|test|last|gallery|timelapse|wrapped|devices|doctor|share|unshare|forget|sync|ui) "cmd_$cmd" "$@" ;;
  -v|--version|version) info "lolcommits $VERSION" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
